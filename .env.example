GOOGLE_API_KEY=your_key_here

# --- RFQ email sending -------------------------------------------------
# TEST_MODE: safety switch for the RFQ "Send All" feature. Defaults to
# "true" if unset. While true, every outgoing email is redirected to
# DEV_EMAIL below, REGARDLESS of the vendor's actual address in the
# database — the subject/body are also marked "[TEST MODE]" so it's
# obvious in the inbox. Only set this to the exact string "false" once
# you are deliberately ready to send real emails to real vendor addresses.
TEST_MODE=true

# DEV_EMAIL: your own inbox. Required whenever TEST_MODE is true — every
# RFQ email lands here instead of the vendor while you're testing.
DEV_EMAIL=your_dev_inbox@example.com

# Gmail account used to actually send RFQ emails via SMTP (only reached
# when TEST_MODE=false, or always as the "From" account). Use an App
# Password (https://myaccount.google.com/apppasswords), never your real
# Gmail login password.
GMAIL_ADDRESS=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# COMPANY_NAME: your hotel/company name, used to personalize outgoing
# emails with a line like "We are reaching out from [your company name]."
# Leave blank/unset to omit that line. RFQ emails ALWAYS use this (an RFQ
# has no PO number, so cluster resolution below doesn't apply to it).
# Pending Market List uses this too, UNLESS IS_CLUSTER is on below.
COMPANY_NAME=

# --- Multi-property ("cluster") name resolution, Pending Market List only ---
# If you manage more than one property and Pending Market List's uploaded
# file mixes PO numbers from more than one of them, set IS_CLUSTER=true
# and list each property below — CLUSTER_1_CODE is the PO number's first
# 2 characters for that property, CLUSTER_1_NAME is what to call it in the
# email. Add CLUSTER_3_CODE/CLUSTER_3_NAME etc. for more than 2 properties.
# A PO number that doesn't match any configured code falls back to
# COMPANY_NAME above. Leave IS_CLUSTER=false (or unset) if you only have
# one property — COMPANY_NAME alone is all you need in that case.
IS_CLUSTER=false
CLUSTER_1_CODE=
CLUSTER_1_NAME=
CLUSTER_2_CODE=
CLUSTER_2_NAME=

# --- Access control ------------------------------------------------------
# ADMIN_PASSWORD: a single shared password gating four specific actions —
# sending real emails (RFQs and Pending Market List), running AI
# extraction (Digitize Comparison Sheet), and adding/updating supplier
# data (Manage Suppliers). Everything else — browsing every tab, drafting
# and previewing, downloading .msg/.eml files — stays fully open with no
# password at all. This is not a real user-account system: there's one
# password, shared by whoever you give it to, entered once per browser
# session. Checked in this order: .streamlit/secrets.toml first (works
# locally too, not just on Streamlit Cloud — add ADMIN_PASSWORD there if
# you'd rather keep it out of .env), then this .env value as a fallback.
# On Streamlit Cloud, set it in the app's Secrets instead.
ADMIN_PASSWORD=